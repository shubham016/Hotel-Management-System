DATABASE_URL=postgresql://hotel_new_era:change-me@db:5432/hotel_new_era_development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:3000
RAILS_ENV=development

# Copy to backend/.env for local Docker Compose, then supply merchant-issued keys.
# Point this to an address reachable by a guest scanning the front-desk QR.
FRONTEND_PUBLIC_URL=http://localhost:3000

ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=

KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=

# Outgoing password-reset notifications. Keep credentials in backend/.env.
MAILER_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=hotelnewera.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
SMTP_SSL=false
