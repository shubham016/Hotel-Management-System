{
  "name": "hotel-new-era",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "backend:build": "docker compose -f backend/compose.yml build",
    "backend:up": "docker compose -f backend/compose.yml up",
    "backend:test": "docker compose -f backend/compose.yml run --rm -e RAILS_ENV=test api bin/rails db:test:prepare test"
  },
  "dependencies": {
    "@inicrea/bikram-sambat-core": "^0.1.3",
    "date-fns": "^3.6.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.5"
  }
}
